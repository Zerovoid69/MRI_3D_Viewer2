# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments -----------------------------------------------
venv/
.venv/
env/
ENV/

# --- IDE / editors --------------------------------------------------------
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Application runtime output -------------------------------------------
output/*
!output/.gitkeep
!output/logs
output/logs/*
!output/logs/.gitkeep
data/*
!data/.gitkeep

# --- Medical imaging data (never commit real patient data) -----------------
*.dcm
*.nii
*.nii.gz
!tests/**/*.nii
!tests/**/*.nii.gz

# --- Test artifacts --------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.egg-info

# --- Exported meshes / masks (user output, not source) -----------------
*.stl
*.obj
*.ply
